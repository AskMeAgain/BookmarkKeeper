<idea-plugin>
    <id>io.github.askmeagain.bookmarkkeeper</id>
    <name>BookmarkKeeper</name>
    <version>1.0.0</version>
    <vendor url="https://github.com/AskMeAgain/BookmarkKeeper">AskMeAgain</vendor>

    <description>
        <!--........................this will be replaced by the pathPluginXml gradle task...........................-->
    </description>

    <idea-version since-build="213.4928.7"/>

    <extensions defaultExtensionNs="com.intellij">
        <tasks.contextProvider order="first" implementation="io.github.askmeagain.bookmarkkeeper.task.BookmarkKeeperContextProviderBefore"/>
        <tasks.contextProvider order="last" implementation="io.github.askmeagain.bookmarkkeeper.task.BookmarkKeeperContextProviderAfter"/>
        <postStartupActivity implementation="io.github.askmeagain.bookmarkkeeper.git.BranchSwitchStartupActivity"/>
    </extensions>

    <depends>com.intellij.tasks</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>Git4Idea</depends>

</idea-plugin>
